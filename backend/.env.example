# ==========================================
# Transt E-Commerce Backend Environment Variables
# ==========================================

# Django Core Settings
SECRET_KEY=your-secure-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.vercel.app

# CORS Settings (frontend origins permitted to query API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database Configuration Options:
# Option A: SQLite (Local development default)
USE_SQLITE=True

# Option B: Managed PostgreSQL Connection String (Render / Railway / Supabase / Neon)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Option C: Individual PostgreSQL Parameters
# USE_SQLITE=False
# DB_NAME=transt_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
